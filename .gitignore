# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Packages/
Package.pins
Package.resolved

# Ruby / Bundler (for Fastlane)
# Note: .bundle/config is intentionally committed — it points Bundler at
# vendor/bundle so first-time setup works without sudo on system Ruby.
vendor/bundle/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/screenshots/**/*.png
fastlane/screenshots/**/*.html

# Environment / secrets — never commit these
.env
.env.*
*.p8
AuthKey_*.p8
