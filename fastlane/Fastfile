# Fastlane configuration for AlgoLens.
#
# First-time setup:
#   1. Install Bundler if needed:           gem install bundler
#   2. Install the locked gem versions:     bundle install
#   3. Run any lane:                        bundle exec fastlane <lane>
#
# Available lanes:
#   bundle exec fastlane test          – run the unit + UI test bundles
#   bundle exec fastlane build         – build a Release .app without signing (sanity check)
#   bundle exec fastlane beta          – archive + upload to TestFlight (requires API key env vars)

default_platform(:ios)

XCODE_PROJECT  = "AlgoLens.xcodeproj"
SCHEME         = "AlgoLens"
TEST_DEVICE    = "iPhone 17 Pro"

platform :ios do
  desc "Run unit and UI tests. Device overridable via FASTLANE_TEST_DEVICE env var."
  lane :test do
    run_tests(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      device: ENV["FASTLANE_TEST_DEVICE"] || TEST_DEVICE,
      clean: true
    )
  end

  desc "Build a Release .app without code signing (CI sanity check)"
  lane :build do
    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Bump the build number, archive, and upload to TestFlight"
  desc "Requires environment variables:"
  desc "  APP_STORE_CONNECT_KEY_ID       – the key ID from App Store Connect"
  desc "  APP_STORE_CONNECT_ISSUER_ID    – the issuer ID from App Store Connect"
  desc "  APP_STORE_CONNECT_API_KEY_PATH – absolute path to your AuthKey_XXXX.p8 file"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath:  ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      in_house:      false
    )

    increment_build_number(xcodeproj: XCODE_PROJECT)

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # CI tip: when you move to a build server, swap `automatic` code signing
  # for `match` (https://docs.fastlane.tools/actions/match/) so certs and
  # provisioning profiles live in a private git repo instead of each Mac.
end
